# ===== SERVER =====
SERVER_PORT=8080
SERVER_CONTEXT_PATH=/api

# ===== DATABASE =====
DB_URL=jdbc:postgresql://localhost:5432/simgan_db
DB_USERNAME=postgres
DB_PASSWORD=postgres

# ===== PLANET LABS =====
PLANET_API_KEY=
PLANET_BASE_URL=https://api.planet.com/data/v1
PLANET_ITEM_TYPE=PSScene
PLANET_ASSET_TYPE=ortho_analytic_4b_sr

# ===== NDVI CONFIG =====
NDVI_ALERT_THRESHOLD=0.3
NDVI_OPTIMAL_THRESHOLD=0.6
NDVI_REST_DAYS=21

# ===== SEED DATA =====
NDVI_SEED_ENABLED=true
NDVI_SEED_MONTHS=6

# ===== DOWNLOAD DIR =====
PLANET_DOWNLOAD_DIR=./tmp/simgan-planet

# ===== COPERNICUS =====
COPERNICUS_USERNAME=tu_email@gmail.com
COPERNICUS_PASSWORD=tu_password

# ===== SENTINEL HUB =====
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=


