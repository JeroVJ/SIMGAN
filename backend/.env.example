# ===== SIMGAN Backend — example env =====
# Copy to .env (or configure equivalents in your hosting provider) and fill in values.

# Public URL where your frontend is hosted (used in reset-password emails)
APP_BASE_URL=https://your-frontend.vercel.app

# CORS: exact origins and optional wildcard patterns (comma-separated)
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app
CORS_ALLOWED_ORIGIN_PATTERNS=https://*.vercel.app

# Database — Postgres connection
DB_URL=jdbc:postgresql://HOST:PORT/DBNAME?sslmode=require
DB_USERNAME=
DB_PASSWORD=

# JWT — generate a long random secret (>= 64 chars)
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# SMTP — Gmail app-password (NOT your Google account password)
MAIL_USERNAME=your-gmail@gmail.com
MAIL_PASSWORD=your-16-char-app-password
MAIL_FROM=SIMGAN <your-gmail@gmail.com>

# External NDVI processing service (optional; leave empty if unused)
IMAGE_PROCESSING_BASE_URL=

# Planet Labs / Sentinel Hub credentials (optional)
PLANET_API_KEY=
COPERNICUS_USERNAME=
COPERNICUS_PASSWORD=
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=
